@{
    Layout = null;
    var returnUrl = (string?)ViewData["ReturnUrl"];
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Digitalt bibliotek - Inloggning</title>
    <link rel="icon" type="image/x-icon" href="~/Books.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-stage">
        <div class="login-card">
            <div class="login-icon">
                <!-- Bokikon -->
                <iconify-icon icon="mdi:bookshelf"></iconify-icon>
                <!--  <img src="~/images/book-icon.png" alt="Bokikon" /> -->
            </div>

            <h1 class="login-title">Digitalt bibliotek</h1>
            <p class="login-subtitle">Logga in för att få åtkomst till ditt konto</p>

            @if (ViewBag.Error != null)
            {
                <div class="login-error">@ViewBag.Error</div>
            }

            <form class="login-form" method="post" asp-controller="Account" asp-action="Login">
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="field">
                    <label for="email">E-postadress</label>
                    <input id="email" type="email" name="email" placeholder="Ange din e-postadress" required />
                </div>

                <div class="field">
                    <label for="password">Lösenord</label>
                    <input id="password" type="password" name="password" placeholder="Ange ditt lösenord" required />
                </div>

                <button class="login-button" type="submit">Logga in</button>

                <div class="login-footer">
                    Endast för internt bruk · Kommunens medarbetare
                </div>
            </form>
        </div>
    </div>
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
</body>
</html>