@model Bibliotekssystem_T9_App.Dtos.CreateUserDto

@{
    ViewData["Title"] = "Skapa användare";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-forms.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-frame">
        <aside class="admin-sidebar">
            <div>
                <h2 class="sidebar-title">Meny</h2>

                <nav class="sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index" class="sidebar-link active">
                        Hantera användare
                    </a>

                    <a href="#" class="sidebar-link">
                        Hantera katalog
                    </a>

                    <a href="#" class="sidebar-link">
                        Hantera utlåningsstatus
                        <span>och påminnelser</span>
                    </a>
                </nav>
            </div>

            <a asp-controller="Admin" asp-action="Index" class="back-link">Till start</a>
        </aside>

        <section class="admin-stage edit-stage">
            <div class="edit-overlay"></div>

            <div class="edit-modal">
                <div class="edit-modal-header">
                    <div class="edit-avatar">
                        <iconify-icon icon="lucide:user-plus"></iconify-icon>
                        <!--👤-->
                    </div>
                    <h1>Skapa användare</h1>
                    <a asp-controller="Admin" asp-action="Index" class="edit-close-btn">✕</a>
                </div>

                <div class="edit-modal-body">
                    <form asp-action="Create" method="post" class="admin-form">
                        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                        <div class="form-group-custom">
                            <label asp-for="FullName">Namn</label>
                            <input asp-for="FullName" class="form-control-custom" />
                            <span asp-validation-for="FullName" class="field-validation-error"></span>
                        </div>

                        <div class="form-group-custom">
                            <label asp-for="Email">E-post</label>
                            <input asp-for="Email" class="form-control-custom" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>

                        <div class="form-row-two">
                            <div class="form-group-custom">
                                <label asp-for="Password">Lösenord</label>
                                <input asp-for="Password" type="password" class="form-control-custom" />
                                <span asp-validation-for="Password" class="field-validation-error"></span>
                            </div>

                            <div class="form-group-custom">
                                <label asp-for="Role">Roll</label>
                                <select asp-for="Role" class="form-control-custom">
                                    <option value="">Välj roll</option>
                                    <option value="User">User</option>
                                    <option value="Admin">Admin</option>
                                </select>
                                <span asp-validation-for="Role" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="save-btn">Spara användare</button>
                            <a asp-controller="Admin" asp-action="Index" class="cancel-btn">Avbryt</a>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}