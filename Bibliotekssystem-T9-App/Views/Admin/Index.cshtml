@model List<Bibliotekssystem_T9_App.Dtos.UserDto>

@{
    ViewData["Title"] = "Admin";
}

<h1>Admin Area</h1>
<p>Du är inloggad som: <strong>@User.Identity?.Name</strong></p>

<form method="post" asp-controller="Account" asp-action="Logout">
    <button class="btn btn-outline-danger" type="submit">Logga ut</button>
</form>

<h2>Användare</h2>
<p>
    <a asp-action="Create" asp-controller="Admin">Skapa ny användare</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Namn</th>
            <th>Email</th>
            <th>Roll</th>
            <th>Åtgärd</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>
                    <a asp-action="Edit" asp-controller="Admin" asp-route-id="@user.Id">Ändra</a>
                    <form asp-action="Delete" asp-controller="Admin" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@user.Id" />
                        <button type="submit">Radera</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>