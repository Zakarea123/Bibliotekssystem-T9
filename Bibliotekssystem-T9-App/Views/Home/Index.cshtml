@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Digital Library - Login</title>
    <link rel="stylesheet" href="~/css/home.css" />
</head>
<body>
<div class="home-shell">
    <div class="home-stage">
        
        <!-- Top bar -->
        <header class="topbar">
            <div class="search-container">
                <div class="searchbox">
                    <span class="search-icon" aria-hidden="true">🔍</span>
                    <input type="text" placeholder="Sök" aria-label="Sök" />
                </div>
            </div>
            
            <nav class="topbar-right" aria-label="Snabbmeny">
                <button class="nav-item" type="button" disabled>
                    <span class="nav-badge">1</span>
                    <span class="nav-emoji" aria-hidden="true">📥</span>
                    <span class="nav-text">Inkorg</span>
                </button>

                <button class="nav-item" type="button" disabled>
                    <span class="nav-badge">1</span>
                    <span class="nav-emoji" aria-hidden="true">🔔</span>
                    <span class="nav-text">Notiser</span>
                </button>
                
                <button class="nav-item" type="button" disabled>
                    <span class="nav-emoji" aria-hidden="true">👤</span>
                    <span class="nav-text">Konto</span>
                </button>
            </nav>
        </header>
        
        <!-- Center panel -->
        <main class="panel">
            <h1 class="panel-title">Välkommen<br/>användare!</h1>

            <section class="action-row" aria-label="Snabbåtgärder">
                <button class="action-tile" type="button" disabled>
                    <div class="tile-label">Låna objekt</div>
                </button>

                <button class="action-tile" type="button" disabled>
                    <div class="tile-label">Returnera objekt</div>
                </button>

                <button class="action-tile" type="button" disabled>
                    <div class="tile-label">Mina lån</div>
                </button>
            </section>

            <section class="info-callout" aria-label="Låneinformation">
                <div class="callout-notch" aria-hidden="true"></div>
                <div class="callout-body">
                    <div>Aktiva lån: <strong>X</strong></div>
                    <div>Nästa återlämning: <strong>X Månad</strong></div>
                </div>
            </section>
        </main>
    </div>
</div>
</body>
</html>
