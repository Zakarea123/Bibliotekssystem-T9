@{
    ViewData["Title"] = "Home Page";
    var isAdmin = User.IsInRole("Admin");
}

<div class="home-stage">
    <main class="panel">
        @if (isAdmin)
        {
            <h1 class="panel-title">Välkommen<br />admin!</h1>

            <section class="action-row" aria-label="Adminåtgärder">
                <a asp-controller="Admin" asp-action="Index" class="action-tile action-tile-admin">
                    <div class="tile-icon">
                        <img src="~/images/BorrowBooks.png" alt="Hantera användare ikon">
                    </div>
                    <div class="tile-label">Hantera användare</div>
                </a>

                <a asp-controller="Catalog" asp-action="Index" class="action-tile action-tile-admin">
                    <div class="tile-icon">
                        <img src="~/images/ReturnBook.png" alt="Hantera objekt ikon">
                    </div>
                    <div class="tile-label">Hantera objekt</div>
                </a>

                <button class="action-tile action-tile-admin" type="button">
                    <div class="tile-icon">
                        <img src="~/images/Mybooks.png" alt="Övrigt ikon">
                    </div>
                    <div class="tile-label">Övrigt</div>
                </button>
            </section>

            <div class="info-callout" aria-label="Admininformation">
                <div class="callout-notch" aria-hidden="true"></div>
                <div class="callout-body">
                    <div>Inkomna returer: <strong>2 st</strong></div>
                    <div>Saknade objekt: <strong>1 st</strong></div>
                </div>
            </div>
        }
        else
        {
            <h1 class="panel-title">Välkommen<br />användare!</h1>

            <section class="action-row" aria-label="Snabbåtgärder">
                <button class="action-tile" type="button">
                    <div class="tile-icon">
                        <img src="~/images/BorrowBooks.png" alt="Låna ikon">
                    </div>
                    <div class="tile-label">Låna objekt</div>
                </button>

                <a asp-controller="Loans" asp-action="Return" class="action-tile">
                    <div class="tile-icon">
                        <img src="~/images/ReturnBook.png" alt="Returnera ikon">
                    </div>
                    <div class="tile-label">Returnera objekt</div>
                </a>

                <a asp-controller="Loans" asp-action="Index" class="action-tile">
                    <div class="tile-icon">
                        <img src="~/images/Mybooks.png" alt="Mina lån ikon">
                    </div>
                    <div class="tile-label">Mina lån</div>
                </a>
            </section>

            <div class="info-callout" aria-label="Låneinformation">
                <div class="callout-notch" aria-hidden="true"></div>
                <div class="callout-body">
                    <div>Aktiva lån: <strong>@(ViewBag.ActiveLoans ?? "—")</strong></div>
                    <div>Nästa återlämning: <strong>@(ViewBag.NextReturn ?? "—")</strong></div>
                </div>
            </div>
        }
    </main>
</div>
