@model List<Bibliotekssystem_T9_App.Models.Item>

@{
    ViewData["Title"] = "Låna objekt";
    var borrowedItemIds = ViewBag.BorrowedItemIds as HashSet<int> ?? new HashSet<int>();
    // Get current day and set max loan days to two weeks
    var today = DateTime.Now.ToString("yyyy-MM-dd");
    var maxDate = DateTime.Now.AddDays(14).ToString("yyyy-MM-dd");
}

<div class="user-frame">
    <aside class="admin-sidebar">
        <h2 class="sidebar-title">Meny</h2>
        <nav class="sidebar-nav">
            <a asp-controller="Loans" asp-action="Borrow" class="sidebar-link active">
                Låna Objekt
            </a>

            <a asp-controller="Loans" asp-action="Return" class="sidebar-link">
                Returnera Objekt
            </a>
                    
            <a asp-controller="Loans" asp-action="Index" class="sidebar-link">
                Mina Lån
            </a>
                    
            <a asp-controller="Loans" asp-action="History" class="sidebar-link">
                Lånhistorik
            </a>
        </nav>
        <a asp-controller="Home" asp-action="Index" class="back-link">Till start</a>
    </aside>
    
<div class="home-stage">
    <main class="panel loans-panel">
        <h1 class="panel-title">Låna objekt</h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-toast">✅ @TempData["SuccessMessage"]</div>
        }

        @if (!Model.Any())
        {
            <p class="no-loans-msg">Inga objekt tillgängliga just nu</p>
        }
        else
        {
            <div class="admin-toolbar">
                <div class="search-form">
                    <input type="text" id="itemSearch" placeholder="Sök efter objekt..." />
                </div>
            </div>
            <div class="loans-table-wrapper">
                <table class="loans-table">
                    <thead>
                    <tr>
                        <th>Titel</th>
                        <th>Typ</th>
                        <th>Status</th>
                        <th>Åtgärd</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var isAvailable = !borrowedItemIds.Contains(item.Id);
                        <tr class="@(!isAvailable ? "row-unavailable" : "")">
                            <td>@item.Title</td>
                            <td>@item.ItemType</td>
                            <td>
                                <span class="status-badge @(isAvailable ? "status-active" : "status-overdue")">
                                    @(isAvailable ? "Tillgänglig" : "Utlånad")
                                </span>
                            </td>
                            <td>
                                @if (isAvailable)
                                {
                                    <button class="borrow-btn" onclick="toggleDatePicker(@item.Id)">Låna</button>
                                    <form asp-action="CreateLoan" asp-controller="Loans" method="post" 
                                          id="borrow-form-@item.Id" class="borrow-form" style="display:none;">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <input type="date" name="dueDate" 
                                               min="@today" max="@maxDate" 
                                               required class="date-input" />
                                        <button type="submit" class="confirm-btn">Bekräfta</button>
                                        <button type="button" class="cancel-btn" onclick="toggleDatePicker(@item.Id)">Avbryt</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </main>
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>