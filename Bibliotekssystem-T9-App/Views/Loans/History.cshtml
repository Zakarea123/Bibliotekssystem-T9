@model List<Bibliotekssystem_T9_App.Models.Loan>

@{
    ViewData["Title"] = "Lånehistorik";
    var itemTitles = ViewBag.ItemTitles as Dictionary<int, string> ?? new Dictionary<int, string>();
}



<div class="user-frame">
    <aside class="admin-sidebar">
        <h2 class="sidebar-title">Meny</h2>
            <nav class="sidebar-nav">
                <a asp-controller="Loans" asp-action="Borrow" class="sidebar-link">
                Låna Objekt
                </a>

                <a asp-controller="Loans" asp-action="Return" class="sidebar-link">
                Returnera Objekt
                </a>
                    
                <a asp-controller="Loans" asp-action="Index" class="sidebar-link">
                Mina Lån
                </a>
                    
                <a asp-controller="Loans" asp-action="History" class="sidebar-link active">
                Lånhistorik
                </a>
            </nav>
    <a asp-controller="Home" asp-action="Index" class="back-link">Till start</a>
</aside>

<div class="home-stage">
    <main class="panel loans-panel">
        
        <h1 class="panel-title">Lånehistorik</h1>

        <!-- Summary row -->
        <div class="loans-summary">
            <div class="summary-chip">Totalt antal lån: <strong>@Model.Count()</strong></div>
        </div>

        @if (!Model.Any())
        {
            <p class="no-loans-msg">Du har ingen lånehistorik</p>
        }
        else
        {
            <div class="loans-table-wrapper">
                <table class="loans-table">
                    <thead>
                    <tr>
                        <th>Objekt</th>
                        <th>Utlånad</th>
                        <th>Förfallodatum</th>
                        <th>Återlämnad</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td>@(itemTitles.ContainsKey(loan.ItemId) ? itemTitles[loan.ItemId] : loan.ItemId.ToString())</td>
                            <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                            <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                            <td>@(loan.ReturnDate.HasValue ? loan.ReturnDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                            <td>
                                <span class="status-badge @(loan.IsReturned ? "status-returned" : loan.DueDate < DateTime.Now ? "status-overdue" : "status-active")">
                                    @(loan.IsReturned ? "Återlämnad" : loan.DueDate < DateTime.Now ? "Förfallen" : "Aktiv")
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        </main>
    </div>
</div>
