@model List<Bibliotekssystem_T9_App.Models.Loan>
@{
    ViewData["Title"] = "Mina lån";
    var itemTitles = ViewBag.ItemTitles as Dictionary<int, string> ?? new Dictionary<int, string>();
}


<div class="user-frame">
    <aside class="admin-sidebar">
        <h2 class="sidebar-title">Meny</h2>
        <nav class="sidebar-nav">
            <a asp-controller="Loans" asp-action="Borrow" class="sidebar-link">
                Låna Objekt
            </a>

            <a asp-controller="Loans" asp-action="Return" class="sidebar-link">
                Returnera Objekt
            </a>
                    
            <a asp-controller="Loans" asp-action="Index" class="sidebar-link active">
                Mina Lån
            </a>
                    
            <a asp-controller="Loans" asp-action="History" class="sidebar-link">
                Lånhistorik
            </a>
            
            <a asp-controller="Reviews" asp-action="Index" class="sidebar-link">
                Recensioner
            </a>
        </nav>
        <a asp-controller="Home" asp-action="Index" class="back-link">Till start</a>
    </aside>


    <div class="home-stage">
        <main class="panel loans-panel">

            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-toast">
                    ✅ @TempData["SuccessMessage"]
                </div>
            }

            <h1 class="panel-title">Mina lån</h1>

            <!-- Summary row -->
            <div class="loans-summary">
                <div class="summary-chip">Aktiva lån: <strong>@Model.Count(l => l.DueDate >= DateTime.Now)</strong></div>
                <div class="summary-chip">Förfallna: <strong>@Model.Count(l => l.DueDate < DateTime.Now)</strong></div>
            </div>
            @if (!Model.Any())
            {
                <p class="no-loans-msg">Du har inga aktiva lån</p>
            }
            else
            {
            <!-- Loans table -->
            <div class="loans-table-wrapper">
                <table class="loans-table">
                    <thead>
                    <tr>
                        <th>Objekt</th>
                        <th>Utlånad</th>
                        <th>Förfallodatum</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td>@(itemTitles != null && itemTitles.ContainsKey(loan.ItemId) ? itemTitles[loan.ItemId] : loan.ItemId.ToString())</td>
                            <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                            <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="status-badge @(loan.DueDate < DateTime.Now ? "status-overdue" : "status-active")">
                                    @(loan.DueDate < DateTime.Now ? "Förfallen" : "Aktiv")
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            }
        </main>
    </div>
</div>

