@model List<Bibliotekssystem_T9_App.Models.Loan>

@{
    ViewData["Title"] = "Returnera objekt";
    var itemTitles = ViewBag.ItemTitles as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="user-frame">
    <aside class="admin-sidebar">
        <h2 class="sidebar-title">Meny</h2>
        <nav class="sidebar-nav">
            <a asp-controller="Loans" asp-action="Borrow" class="sidebar-link">
                Låna Objekt
            </a>

            <a asp-controller="Loans" asp-action="Return" class="sidebar-link active">
                Returnera Objekt
            </a>
                    
            <a asp-controller="Loans" asp-action="Index" class="sidebar-link">
                Mina Lån
            </a>
                    
            <a asp-controller="Loans" asp-action="History" class="sidebar-link">
                Lånhistorik
            </a>
        </nav>
        <a asp-controller="Home" asp-action="Index" class="back-link">Till start</a>
    </aside>


<div class="home-stage">
    <main class="panel loans-panel">
        
        <h1 class="panel-title">Returnera objekt</h1>

        @if (!Model.Any())
        {
            <p class="no-loans-msg">Du har inga aktiva lån att returnera</p>
        }
        else
        {
            <form asp-action="ReturnSelected" asp-controller="Loans" method="post">
                <div class="loans-table-wrapper">
                    <table class="loans-table">
                        <thead>
                        <tr>
                            <th></th>
                            <th>Objekt</th>
                            <th>Utlånad</th>
                            <th>Förfallodatum</th>
                            <th>Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var loan in Model)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="selectedLoanIds" value="@loan.Id" class="loan-checkbox" />
                                </td>
                                <td>@(itemTitles != null && itemTitles.ContainsKey(loan.ItemId) ? itemTitles[loan.ItemId] : loan.ItemId.ToString())</td>
                                <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                                <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="status-badge @(loan.DueDate < DateTime.Now ? "status-overdue" : "status-active")">
                                        @(loan.DueDate < DateTime.Now ? "Förfallen" : "Aktiv")
                                    </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="return-footer">
                    <button type="submit" class="return-btn">Returnera valda</button>
                </div>
            </form>
        }
        </main>
    </div>
</div>