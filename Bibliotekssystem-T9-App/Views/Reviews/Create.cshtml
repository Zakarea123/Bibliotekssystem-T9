@model Bibliotekssystem_T9_App.Models.BookReviews

@{
    ViewData["Title"] = "Skapa recension";
}

<div class="home-stage">
    <main class="panel loans-panel">

        <div class="panel-topbar">
            <a asp-controller="Reviews" asp-action="Index" class="back-btn">← Tillbaka</a>
        </div>

        <h1 class="panel-title">Skapa recension</h1>

        <form asp-action="Create" method="post">

            <div>
                <label>Boktitel</label>
                <input asp-for="BookTitle" class="form-control" required />
            </div>

            <div>
                <label>Användare</label>
                <input asp-for="ReviewerName" class="form-control" required />
            </div>

            <div>
                <label>Betyg (1-5)</label>
                <input asp-for="Rating" type="number" min="1" max="5" class="form-control" required />
            </div>

            <div>
                <label>Kommentar</label>
                <textarea asp-for="Text" class="form-control"></textarea>
            </div>

            <button type="submit" class="history-btn">Spara recension</button>
        </form>

    </main>
</div>