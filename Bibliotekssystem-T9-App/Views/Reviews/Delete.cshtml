@model Bibliotekssystem_T9_App.Models.BookReviews

@{
    ViewData["Title"] = "Ta bort recension";
}

<div class="admin-page">
    <div class="panel loans-panel">

        <section class="admin-stage">
            <div class="admin-card">

                <div class="admin-card-header">
                    <h1>Ta bort recension</h1>
                </div>

                <p>Är du säker att du vill ta bort denna recension?</p>

                <p><strong>@Model.BookTitle</strong></p>
                <p>@Model.Text</p>

                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.ReviewId" />

                    <button type="submit" class="delete-btn">Ta bort</button>
                    <a asp-action="Index" class="back-btn">Avbryt</a>
                </form>

            </div>
        </section>
    </div>
</div>