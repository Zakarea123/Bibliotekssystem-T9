@model Bibliotekssystem_T9_App.Models.BookReviews

@{
    ViewData["Title"] = "Redigera recension";
}

<div class="admin-page">
    <div class="panel loans-panel">

        <section class="admin-stage">
            <div class="admin-card">

                <div class="admin-card-header">
                    <h1>Redigera recension</h1>
                </div>

                <form asp-action="Edit" method="post">

                    <!-- 🔥 KRITISKT -->
                    <input asp-for="ReviewId" type="hidden" />
                    <input asp-for="ReviewerName" type="hidden" />

                    <div class="form-group">
                        <label>Boktitel</label>
                        <input asp-for="BookTitle" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Användare</label>
                        <p><strong>@Model.ReviewerName</strong></p>
                    </div>

                    <div class="form-group">
                        <label>Betyg</label>
                        <input asp-for="Rating" type="number" min="1" max="5" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Kommentar</label>
                        <textarea asp-for="Text" class="form-control"></textarea>
                    </div>

                    <br />

                    <button type="submit" class="create-btn">Spara ändringar</button>
                    <a asp-action="Index" class="back-btn">Avbryt</a>

                </form>

            </div>
        </section>
    </div>
</div>