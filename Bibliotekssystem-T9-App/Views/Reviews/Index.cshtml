@model List<Bibliotekssystem_T9_App.Models.BookReview>

@{
    ViewData["Title"] = "Hantera recensioner";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-frame">

        <aside class="admin-sidebar">
            <div>
                <h2 class="sidebar-title">Meny</h2>

                <nav class="sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index" class="sidebar-link">
                        Hantera användare
                    </a>

                    <a asp-controller="Catalog" asp-action="Index" class="sidebar-link">
                        Hantera katalog
                    </a>

                    <a asp-controller="Reviews" asp-action="Index" class="sidebar-link active">
                        Hantera recensioner
                    </a>
                </nav>
            </div>

            <a asp-controller="Home" asp-action="Index" class="back-link">Till start</a>
        </aside>

        <section class="admin-stage">
            <div class="admin-card">

                <div class="admin-card-header">
                    <h1>Hantera recensioner</h1>
                    <p>Inloggad som <strong>@User.Identity?.Name</strong></p>
                </div>

                <div class="admin-toolbar">
                    <form method="get" asp-action="Index" asp-controller="Reviews" class="search-form">
                        <input type="text"
                               name="searchTerm"
                               value="@Context.Request.Query["searchTerm"]"
                               placeholder="Sök efter recension" />
                    </form>

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <a asp-action="Create" asp-controller="Reviews" class="create-btn">
                            + Skriv recension
                        </a>
                    }
                </div>

                <div class="loans-summary" style="margin-bottom: 0.85rem;">
                    <span>Totalt: <strong>@Model.Count</strong></span>
                </div>

                <div class="table-wrapper">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th>Boktitel</th>
                                <th>Användare</th>
                                <th>Betyg</th>
                                <th>Kommentar</th>
                                <th>Åtgärder</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var review in Model)
                                {
                                    <tr>
                                        <td>@review.BookTitle</td>
                                        <td>@review.ReviewerName</td>
                                        <td>@review.Rating / 5</td>
                                        <td>@review.Text</td>

                                        <td class="action-cell">
                                            @if (User.Identity.IsAuthenticated)
                                            {
                                                <a asp-action="Edit" asp-route-id="@review.ReviewId" class="edit-btn">
                                                    Redigera
                                                </a>

                                                <form asp-action="Delete"
                                                      asp-controller="Reviews"
                                                      method="post"
                                                      class="inline-form"
                                                      onsubmit="return confirm('Vill du verkligen ta bort recensionen?');">

                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@review.ReviewId" />

                                                    <button type="submit" class="delete-btn">
                                                        Ta bort
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="empty-state">
                                        Inga recensioner ännu.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </section>

    </div>
</div>