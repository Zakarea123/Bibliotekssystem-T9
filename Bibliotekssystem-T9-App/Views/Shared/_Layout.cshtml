<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bibliotekssystem_T9_App</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/x-icon" href="~/Books.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Bibliotekssystem_T9_App.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/loans.css" />
</head>
<body>
<div class="home-shell">
    <!-- Top bar -->
    <header class="topbar">
        <div></div> <!-- Spacer Div to center Searchbar -->
        
        <div class="search-container">
            <div class="searchbox">
                <span class="search-icon" aria-hidden="true">🔍</span>
                <input type="text" placeholder="Sök" aria-label="Sök"/>
            </div>
        </div>
        
        <nav class="topbar-right" aria-label="Snabbmeny">
            <!-- Ska vi ha en inkorg? -->
            <!--<button class="nav-item" type="button">
                <span class="nav-badge">0</span>
                <span class="nav-emoji" aria-hidden="true">📥</span>
                <span class="nav-text">Inkorg</span>
            </button> --> 
            <div class="notif-wrapper">
                <button class="nav-item" type="button" id="notif-btn">
                    <span class="nav-badge" id="notif-badge">0</span>
                    <span class="nav-emoji" aria-hidden="true">🔔</span>
                    <span class="nav-text">Notiser</span> 
                </button>
                <div class="notif-panel" id="notif-panel"></div>
            </div>
            <button class="nav-item" type="button">
                <span class="nav-emoji" aria-hidden="true">👤</span>
                <span class="nav-text">Konto</span>
            </button>
        </nav>
    </header>
    
    @RenderBody()
    
    <!-- Bottom-right logout -->
    <button class="logout" type="button">
        <span class="logout-icon" aria-hidden="true">↩</span>
        <span>Logga ut</span>
    </button>
</div>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/site.js"></script>
</body>
</html>
