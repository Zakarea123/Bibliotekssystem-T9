@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAdminPage = User.IsInRole("Admin");
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bibliotekssystem_T9_App</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/x-icon" href="~/Books.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Bibliotekssystem_T9_App.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loans.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="home-shell @(isAdminPage ? "admin-shell-layout" : "")">

        @if (isAdminPage)
        {
            <header class="topbar admin-topbar-layout">
                <div class="admin-topbar-left">
                </div>

                <nav class="topbar-right" aria-label="Admin snabbmeny">
                    <div class="notif-wrapper">
                        <button class="nav-item" type="button" id="notif-btn">
                            <span class="nav-badge" id="notif-badge">0</span>
                            <img src="~/images/notification.png" alt="" aria-hidden="true"
                                 class="nav-icon" />
                            <span class="nav-text">Notiser</span> 
                        </button>
                        <div class="notif-panel" id="notif-panel"></div>
                    </div>

                    <div class="account-wrapper">
                        <button class="nav-item" type="button" id="account-btn">
                            <img src="~/images/user.png" alt="" aria-hidden="true"
                                 class="nav-icon" />
                            <span class="nav-text">Konto</span>
                        </button>
                        <div class="account-panel" id="account-panel">
                            <form method="post" asp-controller="Account" asp-action="Logout">
                                @Html.AntiForgeryToken()
                                <button class="account-panel-item" type="submit">Logga ut</button>
                            </form>
                        </div>
                    </div>
                </nav>
            </header>
        }
        else
        {
            <header class="topbar">
                <div></div>

                <div class="search-container">
                    <div class="searchbox">
                        <span class="search-icon" aria-hidden="true">🔍</span>
                        <input type="text" placeholder="Sök" aria-label="Sök" />
                    </div>
                </div>

                <nav class="topbar-right" aria-label="Snabbmeny">
                        <div class="notif-wrapper">
                        <button class="nav-item" type="button" id="notif-btn">
                            <span class="nav-badge" id="notif-badge">0</span>
                            <img src="~/images/notification.png" alt="" aria-hidden="true"
                                 class="nav-icon" />
                            <span class="nav-text">Notiser</span> 
                        </button>
                        <div class="notif-panel" id="notif-panel"></div>
                    </div>

                    <div class="account-wrapper">
                        <button class="nav-item" type="button" id="account-btn">
                            <img src="~/images/user.png" alt="" aria-hidden="true"
                                 class="nav-icon" />
                            <span class="nav-text">Konto</span>
                        </button>
                        <div class="account-panel" id="account-panel">
                            <div class="account-panel-header">Hej @User.Identity?.Name!</div>
                            <form method="post" asp-controller="Account" asp-action="Logout">
                                @Html.AntiForgeryToken()
                                <button class="account-panel-item" type="submit">Logga ut</button>
                            </form>
                        </div>
                    </div>
                </nav>
            </header>
        }

        @RenderBody()
        
    </div>
    
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>